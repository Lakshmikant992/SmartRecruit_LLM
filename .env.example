# Flask
SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=false
PORT=5000

# Relational database (Neon PostgreSQL or another PostgreSQL provider)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# MongoDB Atlas
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=applications

# Hugging Face inference
API_TOKEN=replace-with-a-hugging-face-token
API_URL=https://api-inference.huggingface.co/models/meta-llama/Meta-Llama-3-8B-Instruct

# Optional shared sessions and cross-origin API access
SESSION_TYPE=filesystem
REDIS_URL=
CORS_ORIGINS=
MAX_CONTENT_LENGTH=16777216

# Optional SMTP notifications
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
